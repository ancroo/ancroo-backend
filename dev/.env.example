# Ancroo Backend — dev environment overrides (all optional)
# Copy to dev/.env to change defaults.

# --- Ports (host side) ---
# DEV_BACKEND_PORT=8900
# DEV_RUNNER_PORT=8510
# DEV_POSTGRES_PORT=5433

# --- Model variant for ./dev.sh import (cuda or rocm) ---
# ANCROO_VARIANT=cuda
# ANCROO_BACKENDS=cuda

# --- External services when running WITHOUT ancroo-stack ---
# (ignored when the stack's ai-network is attached)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# WHISPER_BASE_URL=http://host.docker.internal:8100
# N8N_URL=http://host.docker.internal:5678
# N8N_API_KEY=

# TZ=Europe/Berlin
